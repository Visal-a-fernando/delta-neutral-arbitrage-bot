# ============================================================
#  Delta-Neutral Bot — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ============================================================

# ── Binance Futures API (trade-only permissions — NO withdrawal) ──
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Bybit Futures API (trade-only permissions — NO withdrawal) ────
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# ── Profit Destination ────────────────────────────────────────────
# Pre-approve this address as a withdrawal destination on your exchange
COLD_WALLET_ADDRESS=your_cold_wallet_address_here

# ── Twilio SMS Alerts (optional) ─────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
ALERT_PHONE_NUMBER=+61400000000

# ── Email Alerts (optional, Gmail example) ───────────────────────
ALERT_EMAIL=youremail@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password_here
